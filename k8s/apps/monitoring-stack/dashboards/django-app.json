{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "title": "Django Hospital Application Metrics",
  "tags": ["django", "devsecops"],
  "timezone": "browser",
  "panels": [
    {
      "title": "Request Rate (req/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(django_http_responses_total_by_status_total[5m]))",
          "legendFormat": "Total RPS"
        }
      ]
    },
    {
      "title": "HTTP 5xx Error Rate %",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(django_http_responses_total_by_status_total{status=~\"5..\"}[5m])) / sum(rate(django_http_responses_total_by_status_total[5m])) * 100",
          "legendFormat": "5xx Error %"
        }
      ]
    },
    {
      "title": "Latency Percentiles (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(django_http_requests_latency_seconds_by_view_method_bucket[5m])) by (le)) * 1000",
          "legendFormat": "P50 Latency"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(django_http_requests_latency_seconds_by_view_method_bucket[5m])) by (le)) * 1000",
          "legendFormat": "P95 Latency"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(django_http_requests_latency_seconds_by_view_method_bucket[5m])) by (le)) * 1000",
          "legendFormat": "P99 Latency"
        }
      ]
    },
    {
      "title": "Pod CPU & Memory Utilization",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(node_namespace_pod_container:container_cpu_usage_seconds_total:sum_irate{container=\"django-app\"}) by (pod)",
          "legendFormat": "CPU Usage (cores) - {{pod}}"
        },
        {
          "expr": "sum(container_memory_working_set_bytes{container=\"django-app\"}) by (pod) / 1024 / 1024",
          "legendFormat": "Memory Usage (MiB) - {{pod}}"
        }
      ]
    },
    {
      "title": "Pod Restart Count",
      "type": "stat",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(kube_pod_container_status_restarts_total{container=\"django-app\"})",
          "legendFormat": "Restarts"
        }
      ]
    }
  ],
  "schemaVersion": 38,
  "version": 2
}
